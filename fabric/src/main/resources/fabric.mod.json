{
	"schemaVersion": 1,
	"id": "versiontooltips",
	"version": "${version}",
	"name": "Version Tooltips",
	"description": "This mod adds a simple toggleable tooltip that shows in what version an item was added to the game.",
	"authors": [
		"soldplace",
		"Nicole.srt"
	],
	"contact": {
		"sources": "https://github.com/nicolesrt/VersionTooltips"
	},
	"license": "CC-NC-4.0",
	"icon": "assets/versiontooltips/VersionTooltipsIcon128x128.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"net.soldplace.fabric.VersionTooltipsClient"
		],
		"modmenu": [
			"net.soldplace.config.ModMenuIntegration"
		]
	},
	"depends": {
		"minecraft": "~1.18",
		"fabricloader": ">=0.19.0",
		"fabric": ">=0.44.0+1.18",
		"cloth-config": ">=6.5.102",
		"java": ">=17"
	},
	"suggests": {
		"modmenu": "*"
	}
}